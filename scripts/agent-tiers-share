#!/usr/bin/env bash
# kit-scope: shared
# agent-tiers-share - package the agent-tiers kit for someone else and produce a paste-in install prompt.
#
# TAG-SOURCED (2026-08-10, Wave B): bundles come from `git archive` of a share tag, never the live
# tree. Preflight proves the kit green (clean tree, lint-doctrine, every scripts/*.selfcheck.sh with
# no SKIP line in its output, leak-scan bundle mode, selfcontainment-check, a probe-env.sh smoke run,
# then a push + green selfcheck.yml CI run for HEAD - 2026-08-24, F-16 through F-19: proving green on
# one host/shell is not the same claim as "this bundle works", CI is the cross-OS/shell matrix that
# actually backs it), then tags HEAD as share/<who>-<n> and archives THAT. Exclusions are the
# repo's own .gitignore (never tracked) + .gitattributes export-ignore - no third list to drift.
# Every send appends a share-ledger.tsv row (committed as part of the share action) so
# `git diff share/<who>-<n>..HEAD` answers staleness mechanically. Recipients get push snapshots,
# not repo access, and may deliberately lag.
# The prompt half is unchanged: install or review prompt, optional STRICT untrusted-kit safety
# wrapper, written to the out dir + clipboard.
#
# Usage: agent-tiers-share --who NAME [--review] [--safe|--plain] [-o OUTDIR] [--tag TAG] [--macos]
#   --who NAME        recipient name for the tag + ledger (required unless --tag)
#   --tag TAG         re-send an EXISTING share tag (skips preflight + tagging; no new ledger row
#                     is wrong to want here, so a re-send row IS still appended)
#   --review          emit an AUDIT prompt (review the kit, do NOT install) instead of the install prompt
#   --safe / --plain  skip the interactive question (force safety wrapper on/off)
#   --macos           also run the macos-latest CI legs before tagging (10x minutes multiplier -
#                     default is linux-only; opt in for a bundle that's actually going out the door)
#   -o OUTDIR         output dir (default ~/agent-tiers-dist)
set -euo pipefail

# Resolve the kit from THIS script's location: the kit is shared across profiles, so deriving it from
# CLAUDE_CONFIG_DIR breaks under a second Claude account (that dir holds the flattened view, not the kit).
# $0 alone is not enough - this is the one script meant to be run by BARE NAME from an interactive shell
# (symlinked at ~/bin/agent-tiers-share, per install-flat.sh), and when a command is found via PATH the
# shell execs it with argv[0] exactly as TYPED, not the resolved path. A bare "agent-tiers-share" has no
# `/`, so `dirname "$0"` silently returns "." and KIT_DIR resolves to the parent of whatever the CALLER'S
# cwd happened to be - wrong, and observed live 2026-08-24 ("No git repo at $HOME"). Resolve via `command
# -v` first (only when $0 has no path component - it's already correct otherwise), then follow the
# ~/bin symlink to the canonical script with `readlink -f` (same idiom as dangerous-actions-blocker.sh).
SCRIPT_PATH="$0"
case "$SCRIPT_PATH" in
  */*) : ;;
  *) SCRIPT_PATH="$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")" ;;
esac
SCRIPT_PATH="$(readlink -f -- "$SCRIPT_PATH" 2>/dev/null || printf '%s' "$SCRIPT_PATH")"
KIT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
OUT_DIR="$HOME/agent-tiers-dist"
SAFE=ask
MODE=install
WHO=""
TAG=""
RUN_MACOS=0

while [ $# -gt 0 ]; do
  case "$1" in
    --review) MODE=review ;;
    --safe)  SAFE=1 ;;
    --plain) SAFE=0 ;;
    --macos) RUN_MACOS=1 ;;
    --who)   shift; WHO="${1:?--who needs a name}" ;;
    --tag)   shift; TAG="${1:?--tag needs a tag}" ;;
    -o)      shift; OUT_DIR="${1:?-o needs a dir}" ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

command -v git >/dev/null || { echo "git not found - the kit is shared from its git repo." >&2; exit 1; }
git -C "$KIT_DIR" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "No git repo at $KIT_DIR (resolved from \"$0\") - the kit must be a repo to share (Wave B)." >&2; exit 1; }

# Prompt templates are required kit files: fail HERE, before any state-changing step (tag, archive,
# ledger row, push) - loading them only at prompt time left a renamed template producing a pushed
# tag + ledger row for a share with no prompt (opus reviewer, 2026-08-31). The placeholder grep
# also catches a template edit that lost its substitution markers.
for _tpl in zip-install.txt zip-review.txt safety-wrapper.txt; do
  [ -f "$KIT_DIR/templates/prompts/$_tpl" ] || {
    echo "agent-tiers-share: missing prompt template $KIT_DIR/templates/prompts/$_tpl" >&2; exit 1; }
done
for _tpl in zip-install.txt zip-review.txt; do
  grep -q '__ZIPNAME__' "$KIT_DIR/templates/prompts/$_tpl" || {
    echo "agent-tiers-share: template $_tpl lost its __ZIPNAME__ placeholder" >&2; exit 1; }
done

CI_GATE_NOTE=""; CI_GATE_STATUS="n/a"   # set below only on a fresh tag; "n/a" covers --tag re-send,
                  # where the gate never runs. Both must exist before either branch under `set -u`.
if [ -z "$TAG" ]; then
  [ -n "$WHO" ] || { echo "--who NAME is required (tag becomes share/<who>-<n>)." >&2; exit 2; }
  case "$WHO" in *[!a-z0-9-]*) echo "--who must be lowercase [a-z0-9-] (tag-safe)." >&2; exit 2 ;; esac

  # --- preflight: only a PROVEN-green kit gets tagged --------------------------------------------
  if [ -n "$(git -C "$KIT_DIR" status --porcelain)" ]; then
    echo "Kit tree is DIRTY - commit (or stash) first; a share tag must equal the disk state." >&2
    git -C "$KIT_DIR" status --short >&2; exit 1
  fi
  # T1.5 (2026-08-16): most selfchecks below (12 of 18 on the origin kit at the time of writing; count
  # them with `grep -l 'SKIP.*jq' scripts/*.selfcheck.sh`) exit 0 on "SKIP: jq absent" because their
  # guards fail open by design, and this loop reads exit 0 as PASS - so without jq the kit could be
  # tagged having tested nothing. (Two that don't skip, framing-guard and codex-home-isolate, hard-fail
  # instead - a reason that blames the kit, not the missing dependency.) Refuse up front, real reason.
  command -v jq >/dev/null 2>&1 || { echo "preflight: jq is not installed - the guard selfchecks SKIP without it (exit 0, untested), so a share tag would certify a kit that was never tested. Install jq and re-run. Not tagging." >&2; exit 1; }
  echo "preflight: lint-doctrine" >&2
  "$KIT_DIR/scripts/lint-doctrine.sh" >/dev/null || { echo "lint-doctrine FAILED - not tagging." >&2; exit 1; }
  for sc in "$KIT_DIR"/scripts/*.selfcheck.sh; do
    [ -e "$sc" ] || continue
    echo "preflight: $(basename "$sc")" >&2
    # Capture output rather than discarding it (opus advisor 2026-08-24): a selfcheck can exit 0
    # while SKIPping one of its own assertions (e.g. a missing `unzip`), and jq being present (step
    # 2 above) does not guarantee every other tool a selfcheck might need. A green exit code alone
    # does not mean everything was actually tested - a SKIP line anywhere in the output means it wasn't.
    # `&& SC_RC=0 || SC_RC=$?`, not a bare `VAR="$(cmd)"; RC=$?` (opus reviewer 2026-08-24, HIGH): this
    # file runs under `set -e`, and a plain assignment is a simple command whose own failure exits the
    # SCRIPT right there - the line below never ran, so a red selfcheck aborted with no message at all
    # and $SC_OUT/$SC_RC were never captured for the check that follows.
    SC_OUT="$(sh "$sc" 2>&1)" && SC_RC=0 || SC_RC=$?
    [ "$SC_RC" -eq 0 ] || { echo "$(basename "$sc") FAILED - not tagging." >&2; printf '%s\n' "$SC_OUT" >&2; exit 1; }
    if printf '%s\n' "$SC_OUT" | grep -q '^SKIP'; then
      echo "$(basename "$sc") SKIPPED an assertion (untested, not failed) - not tagging:" >&2
      printf '%s\n' "$SC_OUT" | grep '^SKIP' >&2
      exit 1
    fi
  done
  echo "preflight: leak-scan bundle HEAD" >&2
  # leak-scan.sh is KIT-LOCAL (export-ignored, in neither bundle). A recipient re-sharing must see
  # "not present", not "leak-scan FAILED" - the latter reads as "a leak was found" (T1.4, 2026-08-16).
  [ -f "$KIT_DIR/scripts/leak-scan.sh" ] || { echo "preflight: scripts/leak-scan.sh not present in this kit copy (kit-local, not bundled) - re-sharing from a received bundle is not supported; share from the origin kit. Not tagging." >&2; exit 1; }
  sh "$KIT_DIR/scripts/leak-scan.sh" bundle HEAD || { echo "leak-scan FAILED - not tagging." >&2; exit 1; }
  echo "preflight: selfcontainment-check" >&2
  # selfcontainment-check.sh ships in every bundle (kit-scope: shared) - its absence here means a
  # partial checkout, not a designed exclusion. Same convention as leak-scan.sh above regardless:
  # "not present" is the honest failure, never a message that reads as "a defect was found".
  [ -f "$KIT_DIR/scripts/selfcontainment-check.sh" ] || { echo "preflight: scripts/selfcontainment-check.sh not present in this kit copy - re-sharing from a received bundle is not supported; share from the origin kit. Not tagging." >&2; exit 1; }
  sh "$KIT_DIR/scripts/selfcontainment-check.sh" "$KIT_DIR" || { echo "selfcontainment-check FAILED - not tagging." >&2; exit 1; }
  echo "preflight: probe-env smoke test" >&2
  # probe-env.sh has no selfcheck of its own and is step 1 of `commands/doctor.md` on a recipient's
  # machine - not a full assertion suite, just proof it still parses and exits 0 before it ships
  # (opus advisor 2026-08-24). Real ceiling, not fixed here: it can only prove that on THIS host.
  bash "$KIT_DIR/scripts/probe-env.sh" >/dev/null || { echo "probe-env.sh FAILED to run cleanly - not tagging." >&2; exit 1; }

  # --- CI gate (F-16, opus advisor 2026-08-24): everything above proves the kit green on THIS host
  # only. The real cross-OS/shell matrix is .github/workflows/selfcheck.yml - and this script never
  # ran it before tagging, so at tag time HEAD's CI result was usually absent, not merely unread. Not
  # theoretical: `share-history.txt` names a past commit "fix(darwin): macOS CI found 5 real
  # portability defects" - this exact gap has bitten before. Push, dispatch, then require a green
  # completed run for HEAD before tagging. Hard-fail (not skip) on any tooling/network gap, same
  # discipline as the jq gate above - a silent skip here would be step 2's bug in a new place.
  # `workflow_dispatch` ONLY, not push (2026-08-24): the two macos-latest legs bill at
  # a 10x minutes multiplier and were 88% of this repo's Actions spend from routine dev pushes that
  # never led to a share. This gate now dispatches the run itself instead of relying on an ambient
  # push trigger - CI only ever runs at share time, on whichever branch is actually being shared.
  # 2026-08-29: the macos legs are now ALSO opt-in per dispatch (`--macos`, default off) - a routine
  # re-send only needs the linux legs; run_macos=true is passed explicitly either way so a dispatch
  # never silently inherits the workflow's own default.
  # AGENT_TIERS_SHARE_SKIP_CI_GATE=1 is a TEST-ONLY escape hatch (selfcheck sandboxes have no real
  # GitHub remote to push to) - same seam class as AGENT_TIERS_SHARE_NO_CLIP above. It prints loudly
  # so it can never be mistaken for a normal skip; never set this for a real share.
  # Recorded (opus reviewer 2026-08-24, MEDIUM: the skip was loud in stderr but invisible in every
  # artifact - tag message, ledger row, final report - so scrollback gone meant no way to tell a
  # CI-verified bundle from an unverified one after the fact). CI_GATE_NOTE (declared above) is
  # folded into all three.
  if [ "${AGENT_TIERS_SHARE_SKIP_CI_GATE:-0}" = 1 ]; then
    echo "preflight: !!! CI GATE SKIPPED (AGENT_TIERS_SHARE_SKIP_CI_GATE=1) - not a real share !!!" >&2
    CI_GATE_NOTE=" (CI gate SKIPPED - AGENT_TIERS_SHARE_SKIP_CI_GATE was set)"; CI_GATE_STATUS="skipped"
  else
  command -v gh >/dev/null 2>&1 || { echo "preflight: gh CLI not found - cannot verify CI status before tagging. Install gh and re-run. Not tagging." >&2; exit 1; }
  gh auth status >/dev/null 2>&1 || { echo "preflight: gh is not authenticated - cannot verify CI status before tagging. Run 'gh auth login' and re-run. Not tagging." >&2; exit 1; }
  # TODO: REPO_SLUG comes from gh's resolved base repo but the push below is hard-coded to origin;
  # derive both from the same remote (opus reviewer 2026-08-24, LOW - only diverges with a fork remote,
  # not the case on this single-remote kit today, but would silently poll a repo that never gets the SHA).
  REPO_SLUG="$(cd "$KIT_DIR" && gh repo view --json nameWithOwner -q .nameWithOwner 2>&1)" || { echo "preflight: could not resolve the kit's GitHub repo via gh - not tagging. $REPO_SLUG" >&2; exit 1; }
  BRANCH="$(git -C "$KIT_DIR" branch --show-current)"
  [ -n "$BRANCH" ] || { echo "preflight: detached HEAD - share from a real branch so CI can run against it. Not tagging." >&2; exit 1; }
  # TODO: this is the first irreversible remote action in preflight - a real `git push` with no prompt
  # (opus reviewer 2026-08-24, LOW). Consistent with the script's existing pattern of unprompted local
  # `git tag`/`git commit`, and this pushes your own branch to your own private repo either way, but
  # flagged since it's the first NETWORK-visible one.
  echo "preflight: pushing $BRANCH to origin so CI can see HEAD" >&2
  git -C "$KIT_DIR" push origin "$BRANCH" || { echo "preflight: git push failed - not tagging." >&2; exit 1; }
  SHA="$(git -C "$KIT_DIR" rev-parse HEAD)"
  # Dispatch explicitly (2026-08-24) - selfcheck.yml no longer has a push trigger, so nothing creates
  # a run on its own; without this the poll below would just wait out its full budget on an empty list.
  if [ "$RUN_MACOS" = 1 ]; then RUN_MACOS_ARG=true; else RUN_MACOS_ARG=false; fi
  echo "preflight: dispatching selfcheck CI on $BRANCH (run_macos=$RUN_MACOS_ARG)" >&2
  gh workflow run selfcheck.yml --repo "$REPO_SLUG" --ref "$BRANCH" -f run_macos="$RUN_MACOS_ARG" || { echo "preflight: gh workflow run failed to dispatch - not tagging." >&2; exit 1; }
  # 10 min / 3 consecutive query failures (raised from an initial 5 min / hard-exit-on-first-failure,
  # opus reviewer 2026-08-24, MEDIUM): selfcheck.yml fans out to up to 5 jobs (3 linux always, 2
  # macos-latest with --macos) which queue before starting on a private repo - 5 min was under-sized
  # for the happy path, not just an edge case. Left at 10 min after the 2026-08-29 macos-opt-in split
  # since the default (linux-only, 3 jobs) is strictly faster to queue+run than what this was sized
  # for. A single transient `gh run list` blip used to throw away the whole wait.
  echo "preflight: waiting for selfcheck CI on $SHA (up to 10 min)" >&2
  CI_TRIES=0
  CI_QUERY_FAILS=0
  while :; do
    # TODO: 2>&1 merges any gh stderr into the JSON; on a jq parse failure `set -e` exits here with no
    # message (opus reviewer 2026-08-24, LOW - partly disarmed since gh's own upgrade-notice heuristic
    # is gated on stdout being a terminal, which it isn't here; other stderr notices are not gated).
    if CI_JSON="$(gh run list --repo "$REPO_SLUG" --commit "$SHA" --workflow selfcheck.yml --json status,conclusion --limit 1 2>&1)"; then
      CI_QUERY_FAILS=0
    else
      CI_QUERY_FAILS=$((CI_QUERY_FAILS+1))
      [ "$CI_QUERY_FAILS" -lt 3 ] || { echo "preflight: gh run list failed $CI_QUERY_FAILS times in a row - not tagging. $CI_JSON" >&2; exit 1; }
      sleep 15; CI_TRIES=$((CI_TRIES+1)); continue
    fi
    CI_STATUS="$(printf '%s' "$CI_JSON" | jq -r '.[0].status // empty')"
    CI_CONCLUSION="$(printf '%s' "$CI_JSON" | jq -r '.[0].conclusion // empty')"
    if [ "$CI_STATUS" = "completed" ]; then
      [ "$CI_CONCLUSION" = "success" ] || { echo "preflight: selfcheck CI for $SHA completed with conclusion '$CI_CONCLUSION' - not tagging." >&2; exit 1; }
      if [ "$RUN_MACOS" = 1 ]; then CI_GATE_STATUS="verified-full"; else CI_GATE_STATUS="verified-linux"; fi
      CI_GATE_NOTE=" (CI: $CI_GATE_STATUS)"
      echo "preflight: selfcheck CI green for $SHA ($CI_GATE_STATUS)" >&2
      break
    fi
    CI_TRIES=$((CI_TRIES+1))
    [ "$CI_TRIES" -lt 40 ] || { echo "preflight: selfcheck CI for $SHA did not complete within 10 minutes (last status: ${CI_STATUS:-not started}) - not tagging. Re-run once it's green: gh run list --repo $REPO_SLUG --commit $SHA" >&2; exit 1; }
    sleep 15
  done
  fi

  N=1
  while git -C "$KIT_DIR" rev-parse -q --verify "refs/tags/share/$WHO-$N" >/dev/null; do N=$((N+1)); done
  TAG="share/$WHO-$N"
  git -C "$KIT_DIR" tag -a "$TAG" -m "share bundle for $WHO ($MODE)$CI_GATE_NOTE"
else
  git -C "$KIT_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null || {
    echo "tag $TAG does not exist." >&2; exit 1; }
  WHO="${WHO:-$(printf '%s' "$TAG" | sed -n 's|^share/\([a-z0-9-]*\)-[0-9]*$|\1|p')}"
  WHO="${WHO:-unknown}"
fi

mkdir -p "$OUT_DIR"
STAMP="$(date +%Y%m%d-%H%M)"
ZIP="$OUT_DIR/agent-tiers-${TAG##*/}-$STAMP.zip"

# git archive of the TAG: .gitignore'd files were never tracked, export-ignore drops the
# tracked-but-personal set, --prefix keeps the movable agent-tiers/ top-level dir. Native zip
# writer, so the standalone `zip` tool is no longer a dependency.
git -C "$KIT_DIR" archive --format=zip --prefix=agent-tiers/ -o "$ZIP" "$TAG"
ZIPNAME="$(basename "$ZIP")"
COMMIT="$(git -C "$KIT_DIR" rev-parse --short "$TAG^{commit}")"

# --- send ledger: one row per send (re-sends included), committed as part of the share action ----
# ci_gate column added (opus reviewer 2026-08-24, MEDIUM): "verified-linux" | "verified-full" (with
# --macos) | "skipped" | "n/a" (--tag re-send, gate never runs). Without this, share-ledger.tsv - the
# kit's own provenance record - could not tell a CI-confirmed bundle from an unverified one after the
# terminal scrollback was gone.
# TODO (opus reviewer 2026-08-29, MEDIUM): verified-linux/verified-full record the tier this run
# REQUESTED ($RUN_MACOS), not a tier the matched CI run was confirmed to have actually executed - the
# poll below matches any completed selfcheck.yml run for $SHA with no dispatch run-id captured, so a
# stale run for the same commit (a manual re-dispatch, or one from before this split) could match and
# mislabel. Pre-existing race (the old flat "verified" had the same match logic, just nothing turned
# on the result before); fix by capturing the dispatched run's id and requiring the poll to match it.
LEDGER="$KIT_DIR/share-ledger.tsv"
[ -f "$LEDGER" ] || printf 'date\twho\ttag\tcommit\tmode\tzip\tci_gate\n' > "$LEDGER"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%d)" "$WHO" "$TAG" \
  "$COMMIT" "$MODE" "$ZIPNAME" "$CI_GATE_STATUS" >> "$LEDGER"
git -C "$KIT_DIR" add share-ledger.tsv
git -C "$KIT_DIR" commit -q -m "share: $WHO $TAG ($MODE)$CI_GATE_NOTE" -- share-ledger.tsv

# --- push the tag + the ledger commit (2026-08-24: the CI-gate branch push above only runs on the
# REAL-gate path and happens BEFORE this ledger commit exists, so the
# tag itself and this commit were never pushed anywhere - "recipients get push snapshots, not repo
# access" only held if someone remembered to `git push`/`git push --tags` by hand afterward. share/
# bundle 3, 4, 10 and this bundle-11 run were all local-only until pushed manually. Non-fatal HERE
# (opus reviewer, 2026-08-24): the zip is already on disk but the prompt file + clipboard write are
# still ahead of us below - a hard abort here would destroy the deliverable the recipient actually
# needs, over a gap that's trivially finishable by hand (`git ls-remote origin` proves it; unlike the
# CI-gate result this needs no ledger column, push state is derivable at any time). LOUD instead:
# stderr WARNING, the summary block below, AND a non-zero exit at the very end of the script - exit
# 0 on a failed push is the one channel a non-interactive caller actually reads.
PUSH_STATUS="pushed"
BRANCH="$(git -C "$KIT_DIR" branch --show-current)"
if [ -z "$BRANCH" ]; then
  # detached HEAD: the branch can't be pushed, but the tag can - still worth doing.
  echo "WARNING: detached HEAD - could not push the branch (the ledger commit is stranded on it)." >&2
  if git -C "$KIT_DIR" push origin "$TAG" >&2; then
    PUSH_STATUS="FAILED (detached HEAD, tag pushed, ledger commit still local)"
  else
    PUSH_STATUS="FAILED (detached HEAD, tag push also failed)"
  fi
elif ! git -C "$KIT_DIR" push origin "$BRANCH" "$TAG" >&2; then
  echo "WARNING: push of $BRANCH + $TAG to origin failed - the tag and ledger commit are LOCAL ONLY. Push manually." >&2
  PUSH_STATUS="FAILED (see above)"
fi

# --- prompt templates are FILES under templates/prompts/ (2026-08-31) --------------------------------
# Moved out of quoted heredocs when the public repo gained clone-flavoured siblings in docs/prompts/:
# prompt prose is now file-editable without touching this script, and the bash-3.2 hazard the old
# heredoc-in-function idiom existed to dodge (a `$( )` body pre-scan EXECUTING backticks inside a
# quoted heredoc; measured on macos-latest, 2026-08-16) disappears with the heredocs themselves.
# __ZIPNAME__/__TAG__/__COMMIT__ placeholders are filled below. Read from the LIVE kit dir on
# purpose - the prompt is generated at send time and is not part of the archived tree.
tpl_file() {
  tf="$KIT_DIR/templates/prompts/$1"
  [ -f "$tf" ] || { echo "agent-tiers-share: missing prompt template $tf" >&2; exit 1; }
  cat "$tf"
}
PROMPT_TPL="$(tpl_file zip-install.txt)"
REVIEW_TPL="$(tpl_file zip-review.txt)"

TPL="$PROMPT_TPL"; [ "$MODE" = review ] && TPL="$REVIEW_TPL"
PROMPT="${TPL//__ZIPNAME__/$ZIPNAME}"
PROMPT="${PROMPT//__TAG__/$TAG}"
PROMPT="${PROMPT//__COMMIT__/$COMMIT}"

# --- decide on the safety wrapper --------------------------------------------------------------------
if [ "$SAFE" = ask ]; then
  printf 'Include the third-party / UNTRUSTED safety header + footer? [y/N] '
  read -r ans || ans=""
  case "$ans" in [Yy]*) SAFE=1 ;; *) SAFE=0 ;; esac
fi

# --- the strict safety body (shared by header + footer; see templates/prompts/) ----------------------
SAFETY_BODY="$(tpl_file safety-wrapper.txt)"

if [ "$SAFE" = 1 ]; then
  BAR="================================================================================"
  FINAL="$BAR
 agent-tiers - UNTRUSTED-KIT SAFETY NOTICE (1 of 2)  -  operator + their replies stay trusted
$BAR
$SAFETY_BODY
$BAR

>>>>>>>>>> BEGIN FORWARDED PROMPT (written by the kit's sender) >>>>>>>>>>

$PROMPT

<<<<<<<<<< END FORWARDED PROMPT <<<<<<<<<<

$BAR
 agent-tiers - UNTRUSTED-KIT SAFETY NOTICE (2 of 2)  -  operator + their replies stay trusted
$BAR
$SAFETY_BODY
$BAR"
  SUFFIX="-safe"
else
  FINAL="$PROMPT"
  SUFFIX=""
fi

# --- write the prompt + copy to clipboard ------------------------------------------------------------
PROMPT_FILE="$OUT_DIR/${MODE}-prompt-$STAMP$SUFFIX.txt"
printf '%s\n' "$FINAL" > "$PROMPT_FILE"

CLIP="(no clipboard tool - copy from the .txt)"
# AGENT_TIERS_SHARE_NO_CLIP=1 skips the clipboard entirely (selfcheck / CI - don't clobber the
# operator's clipboard from a test run).
[ "${AGENT_TIERS_SHARE_NO_CLIP:-0}" = 1 ] && CLIP="(skipped: AGENT_TIERS_SHARE_NO_CLIP)"
# NOTE: redirect the clipboard tools' std handles - wl-copy/xclip fork a daemon that holds the SELECTION and
# would otherwise keep this script's stdout fd open, hanging any non-interactive / piped run (CI, an agent's
# shell). The redirect frees the pipe; the daemon still serves the X/Wayland selection fine.
if   [ "${AGENT_TIERS_SHARE_NO_CLIP:-0}" = 1 ]; then : ;
elif command -v wl-copy  >/dev/null; then printf '%s' "$FINAL" | wl-copy >/dev/null 2>&1;                   CLIP="copied to clipboard (wl-copy, Wayland)";
elif command -v xclip    >/dev/null; then printf '%s' "$FINAL" | xclip -selection clipboard >/dev/null 2>&1; CLIP="copied to clipboard (xclip, X11)";
elif command -v pbcopy   >/dev/null; then printf '%s' "$FINAL" | pbcopy >/dev/null 2>&1;                     CLIP="copied to clipboard (pbcopy, macOS)";
elif command -v clip.exe >/dev/null; then printf '%s' "$FINAL" | clip.exe >/dev/null 2>&1;                   CLIP="copied to clipboard (clip.exe, Windows)"; fi

# --- report ------------------------------------------------------------------------------------------
echo
echo "  mode         $MODE ($( [ "$MODE" = review ] && echo 'audit, do NOT install' || echo 'install' ))"
echo "  tag          $TAG ($(git -C "$KIT_DIR" rev-parse --short "$TAG^{commit}")) - staleness: git diff $TAG..HEAD"
echo "  CI gate      $CI_GATE_STATUS"
echo "  ledger       share-ledger.tsv row appended + committed"
