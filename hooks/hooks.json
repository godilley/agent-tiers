{
  "description": "agent-tiers hooks. Generated from install/options.tsv by scripts/gen-plugin-manifests.sh: do not edit by hand. Every hook first runs the kit gate, which stands it down when the kit is off or the hook's group is off. A plain install runs at Core level: only the session handoff and housekeeping hooks act, and the other groups are turned on in the plugin options.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/resume-inject.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-home-isolate.sh\"",
            "timeout": 10
