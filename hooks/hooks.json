{
  "description": "agent-tiers - re-inject the project's RESUME_SESSION.md handoff and isolate CODEX_HOME per session on a fresh/compacted/resumed session (both guarded: silent when nothing applies); at SessionEnd, one stderr line summarising this session's guard blocks from .state/guards.log.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/resume-inject.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/codex-home-isolate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-summary.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
